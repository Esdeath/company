POSTGRES_DB=company
POSTGRES_USER=company
POSTGRES_PASSWORD=company_local_only
DATABASE_URL=postgresql+psycopg://company:company_local_only@postgres:5432/company
ADMIN_USERNAME=admin
# Local-only password: company_local_only. Generate a different production hash with scripts/hash-admin-password.sh.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$aXR5J2OvFOW7Bb653Nn6mQ$Mjw20TGkSlMBsX4JsoCVfOe1DH6Cedzk01lTosf8YPU'
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CONTENT_ROOT=../../var/content
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=43200
APP_ENVIRONMENT=development
USER_REGISTRATION_ENABLED=false
COMMENT_WRITES_ENABLED=true
USER_SESSION_LIFETIME_SECONDS=2592000
USER_TOKEN_SIGNING_KEY=local-development-only-signing-key
EMAIL_BACKEND=console
EMAIL_CAPTURE_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
SMTP_SENDER=
PUBLIC_BASE_URL=http://127.0.0.1:3000
EMAIL_DISPATCH_INTERVAL_SECONDS=2
EMAIL_MAX_ATTEMPTS=8
